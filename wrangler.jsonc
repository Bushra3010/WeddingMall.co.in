{
  // Cloudflare Workers deployment via @opennextjs/cloudflare.
  // `npm run cf:build` produces .open-next/, `npm run cf:deploy` ships it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weddingmall",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // `/_next/image` resizes through Cloudflare Images (free: 5,000 unique
  // transformations a month; this site needs well under 1,000). Without the
  // binding the adapter serves the original file — a 2 MB PNG to a phone.
  "images": { "binding": "IMAGES" },
  // ISR pages and unstable_cache entries live in Workers KV (free: 100k reads
  // and 1k writes a day, no card needed). R2 is the better long-term store
  // (1M writes a month) once it is enabled on the account: swap this for an
  // `r2_buckets` entry bound to NEXT_INC_CACHE_R2_BUCKET and switch
  // open-next.config.ts to the r2 override.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "c6078afb88aa43d1862d72992990d280",
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "weddingmall",
    },
  ],
  // Plain, non-secret settings. Secrets (SUPABASE_SECRET_KEY, CRON_SECRET,
  // Razorpay, email) go in with `wrangler secret put`.
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://www.weddingmall.co.in",
    "NEXT_TELEMETRY_DISABLED": "1",
    "FEATURE_REALTIME_CHAT": "true",
    "FEATURE_ONLINE_PAYMENTS": "false",
    "FEATURE_PHONE_AUTH": "false",
    "ADMIN_MFA_REQUIRED": "false",
  },
  // Custom domains: Cloudflare creates the DNS records and certificates.
  // The apex should 301 to www (Rules → Redirect Rules in the dashboard).
  "routes": [
    { "pattern": "www.weddingmall.co.in", "custom_domain": true },
    { "pattern": "weddingmall.co.in", "custom_domain": true },
  ],
  "observability": { "enabled": true },
}
