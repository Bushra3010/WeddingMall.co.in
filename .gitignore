# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env
.env.local
.env*.local

# test artefacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
coverage/

# supabase
supabase/.temp/
supabase/.branches/

# --- Capacitor / Android ---------------------------------------------------
# The android/ project itself IS committed: it holds the manifest, icons,
# splash and Gradle config that make the APK reproducible. Only build output
# and machine-specific or secret files are excluded.
android/build/
android/app/build/
android/.gradle/
android/.idea/
android/local.properties
android/app/release/
android/captures/
*.apk
*.aab

# Signing material. A committed keystore lets anyone publish an update that
# Android will accept as genuine, and the key cannot be rotated once an app is
# live — losing control of it means losing the listing.
*.jks
*.keystore
android/keystore.properties

# --- Capacitor / iOS -------------------------------------------------------
# The ios/ project IS committed: Info.plist, icons, splash, the storyboard and
# the Xcode project are what make a build reproducible. Only build output,
# machine-specific state, and anything that can sign a release is excluded.
ios/App/build/
ios/App/Pods/
ios/App/App/public/
ios/App/DerivedData/
ios/App/output/
*.xcuserstate
xcuserdata/
*.ipa
*.dSYM.zip

# Signing material. A provisioning profile or a .p12 in git is an app someone
# else can publish as you.
*.mobileprovision
*.p12
*.certSigningRequest

# Throwaway scripts. Several one-off migration/probe runners were written at the
# repo root during setup because node resolves `pg` and `sharp` from here; one
# (`_ap.mjs`) reached a commit. Anything underscore-prefixed at the root is
# scratch and should never be tracked.
/_*.mjs
/_*.js
/_*.ts
