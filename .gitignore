# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env
.env.local
.env*.local

# test artefacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
coverage/

# supabase
supabase/.temp/
supabase/.branches/

# --- Capacitor / Android ---------------------------------------------------
# The android/ project itself IS committed: it holds the manifest, icons,
# splash and Gradle config that make the APK reproducible. Only build output
# and machine-specific or secret files are excluded.
android/build/
android/app/build/
android/.gradle/
android/.idea/
android/local.properties
android/app/release/
android/captures/
*.apk
*.aab

# Signing material. A committed keystore lets anyone publish an update that
# Android will accept as genuine, and the key cannot be rotated once an app is
# live — losing control of it means losing the listing.
*.jks
*.keystore
android/keystore.properties
