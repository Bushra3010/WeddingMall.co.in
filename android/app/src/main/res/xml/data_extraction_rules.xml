<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules.

  Everything is excluded. The WebView's storage holds Supabase session cookies
  and tokens; letting Android copy those into a cloud backup or onto a new
  handset would move a live signed-in session somewhere the sign-out flow
  cannot reach. Signing in again on the new device costs one screen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
