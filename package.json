{
  "name": "wedding-mall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file=.env.local node_modules/.bin/playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "node --env-file=.env.local scripts/gen-types.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:apply": "node --env-file=.env.local scripts/apply-migrations.mjs",
    "db:seed": "node --env-file=.env.local scripts/apply-migrations.mjs --seed-only",
    "check:permissions": "node --env-file=.env.local scripts/permission-parity.mjs",
    "db:rls": "node --env-file=.env.local scripts/rls-probe.mjs && node --env-file=.env.local scripts/rls-tenant-probe.mjs && node --env-file=.env.local scripts/rls-onboarding-probe.mjs && node --env-file=.env.local scripts/rls-listing-probe.mjs && node --env-file=.env.local scripts/rls-enquiry-probe.mjs && node --env-file=.env.local scripts/rls-review-probe.mjs && node --env-file=.env.local scripts/rls-billing-probe.mjs && node --env-file=.env.local scripts/rls-realtime-probe.mjs && node --env-file=.env.local scripts/rls-taxonomy-probe.mjs",
    "grant-admin": "node --env-file=.env.local scripts/grant-admin.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo-vendors.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@hookform/resolvers": "^5.5.7",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^7.6.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^26.1.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
